{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": false,
    "module": "node16",
    "lib": ["ES2021"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "../*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "!src/**/__tests__/**/*",
    "!src/**/__mocks__/**/*",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "exclude": [
    "src/__tests__",
    "**/__mocks__/**/*",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}